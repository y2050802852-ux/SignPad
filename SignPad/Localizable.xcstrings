{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "开始签名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Signing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始签名"
          }
        }
      }
    },
    "继续编辑": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue Editing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续编辑"
          }
        }
      }
    },
    "完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "撤销": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        }
      }
    },
    "清空": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空"
          }
        }
      }
    },
    "导出": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出"
          }
        }
      }
    },
    "好": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "导出失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出失败"
          }
        }
      }
    },
    "历史签名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史签名"
          }
        }
      }
    },
    "暂无签名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No signatures yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无签名"
          }
        }
      }
    },
    "完成第一次签名后会显示在这里": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first signature will appear here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成第一次签名后会显示在这里"
          }
        }
      }
    },
    "重新编辑": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-edit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新编辑"
          }
        }
      }
    },
    "删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "删除全部历史签名？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all signatures?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除全部历史签名？"
          }
        }
      }
    },
    "全部删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部删除"
          }
        }
      }
    },
    "取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "共 %lld 条，此操作不可撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld in total. This action cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 条，此操作不可撤销。"
          }
        }
      }
    },
    "已导出到 ~/Desktop/签名/": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exported to ~/Desktop/签名/"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导出到 ~/Desktop/签名/"
          }
        }
      }
    },
    "在 Finder 中显示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal in Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中显示"
          }
        }
      }
    },
    "单指在触控板上签名 · 抬起手指结束一笔 · 按 Esc 或点「完成」结束签名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign with one finger on the trackpad · Lift to end a stroke · Press Esc or click Done to finish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单指在触控板上签名 · 抬起手指结束一笔 · 按 Esc 或点「完成」结束签名"
          }
        }
      }
    },
    "笔刷": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brush"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔刷"
          }
        }
      }
    },
    "笔画粗细 0.5×–3×（对新落的笔画生效）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stroke width 0.5×–3× (applies to new strokes)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔画粗细 0.5×–3×（对新落的笔画生效）"
          }
        }
      }
    },
    "钢笔·笔锋": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fountain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钢笔·笔锋"
          }
        }
      }
    },
    "圆珠笔": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ballpoint"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆珠笔"
          }
        }
      }
    },
    "马克笔": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "马克笔"
          }
        }
      }
    },
    "铅笔·纹理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencil"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铅笔·纹理"
          }
        }
      }
    },
    "墨黑": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ink Black"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨黑"
          }
        }
      }
    },
    "靛蓝": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Indigo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靛蓝"
          }
        }
      }
    },
    "朱红": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermilion"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朱红"
          }
        }
      }
    },
    "鎏金": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鎏金"
          }
        }
      }
    },
    "松绿": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine Green"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松绿"
          }
        }
      }
    },
    "青紫": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Violet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "青紫"
          }
        }
      }
    },
    "画布为空，先完成一次签名再导出": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas is empty — sign first, then export"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布为空，先完成一次签名再导出"
          }
        }
      }
    },
    "位图渲染失败，请重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitmap rendering failed, try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位图渲染失败，请重试"
          }
        }
      }
    },
    "无法创建导出文件夹：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot create export folder: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建导出文件夹：%@"
          }
        }
      }
    },
    "生成的 SVG 校验未通过：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated SVG failed validation: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成的 SVG 校验未通过：%@"
          }
        }
      }
    },
    "保存历史失败：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to save history: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存历史失败：%@"
          }
        }
      }
    },
    "未知错误": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown error"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知错误"
          }
        }
      }
    }
  }
}
